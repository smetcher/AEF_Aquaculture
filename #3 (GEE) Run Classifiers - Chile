// =============================================================================
// 43. CHILE VALIDATION-FOOTPRINT SENSITIVITY ANALYSIS
// =============================================================================
//
// PURPOSE
//   Test whether evaluation results depend materially on uncertainty in the
//   spatial extent of the 2025 validation footprints.
//
// THREE SCENARIOS
//
//   CONTRACTED
//     radial objects  = 40 m radius
//     polygon objects = -10 m buffer
//
//   NOMINAL
//     radial objects  = 50 m radius
//     polygon objects = unchanged
//
//   EXPANDED
//     radial objects  = 60 m radius
//     polygon objects = +10 m buffer
//
// INTERPRETATION
//   Every validation boundary is displaced by one AEF pixel (10 m) relative
//   to the primary validation geometry.
//
// IMPORTANT
//   - Models are NOT retrained.
//   - Predictions are NOT changed.
//   - Cosine thresholds are NOT changed.
//   - Water mask is NOT changed.
//   - Connected-pixel filtering is NOT changed.
//   - Only validation geometry is changed.
//
// OUTPUT
//   Chile_2025_validation_footprint_sensitivity.csv
//
// QA
//   The NOMINAL scenario must reproduce the existing Chile main results.
// =============================================================================


// =============================================================================
// 43.1 SENSITIVITY CONFIGURATION
// =============================================================================

var FOOTPRINT_SCENARIOS = [

  {
    name: 'contracted',
    radial_radius_m: 40,
    polygon_buffer_m: -10
  },

  {
    name: 'nominal',
    radial_radius_m: 50,
    polygon_buffer_m: 0
  },

  {
    name: 'expanded',
    radial_radius_m: 60,
    polygon_buffer_m: 10
  }

];


var FOOTPRINT_SENSITIVITY_EXPORT_FOLDER =
  'GEE_Sensitivity_Exports';


// =============================================================================
// 43.2 BUILD VALIDATION GEOMETRY FOR ONE SCENARIO
// =============================================================================

function buildFootprintSensitivityGroundTruth(
  scenarioName,
  radialRadiusM,
  polygonBufferM
) {

  radialRadiusM =
    ee.Number(radialRadiusM);

  polygonBufferM =
    ee.Number(polygonBufferM);


  // ---------------------------------------------------------------------------
  // POLYGON OBJECTS
  // ---------------------------------------------------------------------------

  var polygons =
    ground_truth_poly.map(
      function(f) {

        var originalGeom =
          f.geometry();


        var proposedGeom =
          ee.Geometry(
            ee.Algorithms.If(
              polygonBufferM.eq(0),
              originalGeom,
              originalGeom.buffer(
                polygonBufferM,
                1
              )
            )
          );


        var proposedArea =
          proposedGeom.area(1);


        // Flag polygons that collapse under the -10 m contraction.
        //
        // The original geometry is retained only to keep the collection valid.
        // If collapsed_polygon_count > 0, do NOT interpret the contracted
        // scenario until those polygons have been inspected.
        var collapsed =
          ee.Number(
            ee.Algorithms.If(
              proposedArea.gt(0),
              0,
              1
            )
          );


        var finalGeom =
          ee.Geometry(
            ee.Algorithms.If(
              proposedArea.gt(0),
              proposedGeom,
              originalGeom
            )
          );


        return ee.Feature(
          finalGeom,
          f.toDictionary()
        )
        .set({

          object_type:
            'polygon',

          radius_m:
            0,

          sensitivity_scenario:
            scenarioName,

          polygon_buffer_m:
            polygonBufferM,

          radial_radius_m:
            0,

          original_area_m2:
            originalGeom.area(1),

          sensitivity_area_m2:
            finalGeom.area(1),

          collapsed_polygon:
            collapsed

        });

      }
    );


  // ---------------------------------------------------------------------------
  // RADIAL OBJECTS
  //
  // Rebuilt directly from the ORIGINAL cage-centre points.
  // ---------------------------------------------------------------------------

  var radials =
    ground_truth_radial.map(
      function(f) {

        var sensitivityGeom =
          f.geometry()
            .buffer(
              radialRadiusM,
              1
            );


        var nominalGeom =
          f.geometry()
            .buffer(
              ISOLATED_RADIUS_M,
              1
            );


        return ee.Feature(
          sensitivityGeom,
          f.toDictionary()
        )
        .set({

          object_type:
            'radial',

          radius_m:
            radialRadiusM,

          sensitivity_scenario:
            scenarioName,

          polygon_buffer_m:
            0,

          radial_radius_m:
            radialRadiusM,

          original_area_m2:
            nominalGeom.area(1),

          sensitivity_area_m2:
            sensitivityGeom.area(1),

          collapsed_polygon:
            0

        });

      }
    );


  var combined =
    polygons
      .merge(radials)
      .filterBounds(
        scanningArea
      );


  // ---------------------------------------------------------------------------
  // Deterministic validation IDs
  // ---------------------------------------------------------------------------

  var combinedList =
    combined.toList(
      combined.size()
    );


  var combinedIndex =
    ee.List.sequence(
      0,
      combined.size().subtract(1)
    );


  return ee.FeatureCollection(
    combinedIndex.map(
      function(i) {

        i =
          ee.Number(i);


        var f =
          ee.Feature(
            combinedList.get(i)
          );


        var objectType =
          ee.String(
            f.get('object_type')
          );


        var validationID =
          objectType
            .cat('_')
            .cat(
              i.add(1)
                .format('%03d')
            );


        return f.set(
          'validation_id',
          validationID
        );

      }
    )
  );

}


// =============================================================================
// 43.3 BUILD UNION TRUTH RASTER
// =============================================================================
//
// Validation geometries are rasterised into a single binary truth surface.
//
// Therefore:
//   overlapping validation pixels count ONCE in the pixel-level confusion
//   matrix.
// =============================================================================

function buildFootprintSensitivityTruthRaster(
  sensitivityGT
) {

  return evaluationBase
    .paint({
      featureCollection:
        sensitivityGT,

      color:
        1
    })
    .rename(
      'truth'
    )
    .updateMask(
      evaluationDomain
    )
    .toByte()
    .setDefaultProjection(
      EVAL_PROJ
    );

}


// =============================================================================
// 43.4 PIXEL-LEVEL SENSITIVITY METRICS
// =============================================================================

function footprintSensitivityPixelMetrics(
  scenarioName,
  radialRadiusM,
  polygonBufferM,
  methodCode,
  methodName,
  pred,
  sensitivityTruth
) {

  pred =
    pred
      .rename(
        'prediction'
      )
      .clip(
        scanningArea
      )
      .unmask(0)
      .toByte()
      .setDefaultProjection(
        EVAL_PROJ
      );


  var truthBinary =
    sensitivityTruth
      .unmask(0)
      .toByte()
      .setDefaultProjection(
        EVAL_PROJ
      );


  var tp =
    pred
      .eq(1)
      .and(
        truthBinary.eq(1)
      )
      .rename(
        'TP'
      )
      .toInt();


  var fp =
    pred
      .eq(1)
      .and(
        truthBinary.eq(0)
      )
      .rename(
        'FP'
      )
      .toInt();


  var fn =
    pred
      .eq(0)
      .and(
        truthBinary.eq(1)
      )
      .rename(
        'FN'
      )
      .toInt();


  var tn =
    pred
      .eq(0)
      .and(
        truthBinary.eq(0)
      )
      .rename(
        'TN'
      )
      .toInt();


  var countImage =
    ee.Image.cat([
      tp,
      fp,
      fn,
      tn
    ])
    .updateMask(
      evaluationDomain
    )
    .setDefaultProjection(
      EVAL_PROJ
    );


  var counts =
    countImage.reduceRegion({

      reducer:
        ee.Reducer
          .sum()
          .unweighted(),

      geometry:
        scanningArea,

      scale:
        SCALE,

      crs:
        AOI_CRS,

      maxPixels:
        1e13,

      tileScale:
        4

    });


  var TP =
    safeGet(
      counts,
      'TP'
    );


  var FP =
    safeGet(
      counts,
      'FP'
    );


  var FN =
    safeGet(
      counts,
      'FN'
    );


  var TN =
    safeGet(
      counts,
      'TN'
    );


  var truthPositivePixels =
    TP.add(
      FN
    );


  var precision =
    safeDivide(
      TP,
      TP.add(FP)
    );


  var recall =
    safeDivide(
      TP,
      TP.add(FN)
    );


  var f1 =
    safeDivide(
      TP.multiply(2),
      TP.multiply(2)
        .add(FP)
        .add(FN)
    );


  var iou =
    safeDivide(
      TP,
      TP
        .add(FP)
        .add(FN)
    );


  return ee.Dictionary({

    sensitivity_scenario:
      scenarioName,

    radial_radius_m:
      radialRadiusM,

    polygon_buffer_m:
      polygonBufferM,

    method_code:
      methodCode,

    method:
      methodName,

    truth_positive_pixels:
      truthPositivePixels,

    truth_positive_area_m2:
      truthPositivePixels.multiply(
        SCALE * SCALE
      ),

    TP_pixels:
      TP,

    TN_pixels:
      TN,

    FP_pixels:
      FP,

    FN_pixels:
      FN,

    precision:
      precision,

    recall:
      recall,

    F1:
      f1,

    IoU:
      iou

  });

}


// =============================================================================
// 43.5 OBJECT-LEVEL SCORING
// =============================================================================

function scoreFootprintSensitivityObjects(
  sensitivityGT,
  pred
) {

  pred =
    pred
      .clip(
        scanningArea
      )
      .unmask(0)
      .toByte()
      .setDefaultProjection(
        EVAL_PROJ
      );


  return sensitivityGT.map(
    function(f) {

      var evalGeom =
        f.geometry()
          .intersection(
            scanningArea,
            1
          );


      var objectTruth =
        ee.Image.constant(0)
          .toByte()
          .paint({

            featureCollection:
              ee.FeatureCollection([
                ee.Feature(f)
              ]),

            color:
              1

          })
          .rename(
            'object_truth'
          )
          .clip(
            scanningArea
          )
          .setDefaultProjection(
            EVAL_PROJ
          )
          .updateMask(
            evaluationDomain
          );


      var gtPixelsImage =
        objectTruth
          .eq(1)
          .rename(
            'gt_pixels'
          )
          .toInt();


      var overlapPixelsImage =
        pred
          .eq(1)
          .and(
            objectTruth.eq(1)
          )
          .rename(
            'overlap_pixels'
          )
          .toInt();


      var countImage =
        ee.Image.cat([
          gtPixelsImage,
          overlapPixelsImage
        ])
        .updateMask(
          evaluationDomain
        )
        .setDefaultProjection(
          EVAL_PROJ
        );


      var counts =
        countImage.reduceRegion({

          reducer:
            ee.Reducer
              .sum()
              .unweighted(),

          geometry:
            evalGeom,

          scale:
            SCALE,

          crs:
            AOI_CRS,

          maxPixels:
            1e10,

          tileScale:
            4

        });


      var gtPixels =
        safeGet(
          counts,
          'gt_pixels'
        );


      var overlapPixels =
        safeGet(
          counts,
          'overlap_pixels'
        );


      var overlapFraction =
        safeDivide(
          overlapPixels,
          gtPixels
        );


      var evaluable =
        ee.Number(
          ee.Algorithms.If(
            gtPixels.gt(0),
            1,
            0
          )
        );


      var detectedAny =
        ee.Number(
          ee.Algorithms.If(
            overlapPixels.gt(0),
            1,
            0
          )
        );


      var detected10 =
        ee.Number(
          ee.Algorithms.If(
            overlapFraction.gte(0.10),
            1,
            0
          )
        );


      var detected25 =
        ee.Number(
          ee.Algorithms.If(
            overlapFraction.gte(0.25),
            1,
            0
          )
        );


      return f.set({

        evaluable_object:
          evaluable,

        evaluable_gt_pixels:
          gtPixels,

        overlap_pixels:
          overlapPixels,

        overlap_fraction:
          overlapFraction,

        detected_any:
          detectedAny,

        detected_10pct:
          detected10,

        detected_25pct:
          detected25

      });

    }
  );

}


// =============================================================================
// 43.6 OBJECT-LEVEL SUMMARY
// =============================================================================

function summariseFootprintSensitivityObjects(
  scoredObjects
) {

  var evaluableAll =
    scoredObjects.filter(
      ee.Filter.eq(
        'evaluable_object',
        1
      )
    );


  var radialAll =
    scoredObjects.filter(
      ee.Filter.eq(
        'object_type',
        'radial'
      )
    );


  var polygonAll =
    scoredObjects.filter(
      ee.Filter.eq(
        'object_type',
        'polygon'
      )
    );


  var evaluableRadial =
    radialAll.filter(
      ee.Filter.eq(
        'evaluable_object',
        1
      )
    );


  var evaluablePolygon =
    polygonAll.filter(
      ee.Filter.eq(
        'evaluable_object',
        1
      )
    );


  var nAll =
    scoredObjects.size();


  var nEvalAll =
    evaluableAll.size();


  var nRadial =
    radialAll.size();


  var nEvalRadial =
    evaluableRadial.size();


  var nPolygon =
    polygonAll.size();


  var nEvalPolygon =
    evaluablePolygon.size();


  var collapsedPolygonCount =
    polygonAll
      .filter(
        ee.Filter.eq(
          'collapsed_polygon',
          1
        )
      )
      .size();


  // ---------------------------------------------------------------------------
  // ALL OBJECTS
  // ---------------------------------------------------------------------------

  var allDetectedAny =
    ee.Number(
      evaluableAll.aggregate_sum(
        'detected_any'
      )
    );


  var allDetected10 =
    ee.Number(
      evaluableAll.aggregate_sum(
        'detected_10pct'
      )
    );


  var allDetected25 =
    ee.Number(
      evaluableAll.aggregate_sum(
        'detected_25pct'
      )
    );


  var allMeanCoverage =
    ee.Number(
      ee.Algorithms.If(
        nEvalAll.gt(0),
        evaluableAll.aggregate_mean(
          'overlap_fraction'
        ),
        0
      )
    );


  // ---------------------------------------------------------------------------
  // RADIAL OBJECTS
  // ---------------------------------------------------------------------------

  var radialDetectedAny =
    ee.Number(
      ee.Algorithms.If(
        nEvalRadial.gt(0),
        evaluableRadial.aggregate_sum(
          'detected_any'
        ),
        0
      )
    );


  var radialDetected10 =
    ee.Number(
      ee.Algorithms.If(
        nEvalRadial.gt(0),
        evaluableRadial.aggregate_sum(
          'detected_10pct'
        ),
        0
      )
    );


  var radialDetected25 =
    ee.Number(
      ee.Algorithms.If(
        nEvalRadial.gt(0),
        evaluableRadial.aggregate_sum(
          'detected_25pct'
        ),
        0
      )
    );


  var radialMeanCoverage =
    ee.Number(
      ee.Algorithms.If(
        nEvalRadial.gt(0),
        evaluableRadial.aggregate_mean(
          'overlap_fraction'
        ),
        0
      )
    );


  // ---------------------------------------------------------------------------
  // POLYGON OBJECTS
  // ---------------------------------------------------------------------------

  var polygonDetectedAny =
    ee.Number(
      ee.Algorithms.If(
        nEvalPolygon.gt(0),
        evaluablePolygon.aggregate_sum(
          'detected_any'
        ),
        0
      )
    );


  var polygonDetected10 =
    ee.Number(
      ee.Algorithms.If(
        nEvalPolygon.gt(0),
        evaluablePolygon.aggregate_sum(
          'detected_10pct'
        ),
        0
      )
    );


  var polygonDetected25 =
    ee.Number(
      ee.Algorithms.If(
        nEvalPolygon.gt(0),
        evaluablePolygon.aggregate_sum(
          'detected_25pct'
        ),
        0
      )
    );


  var polygonMeanCoverage =
    ee.Number(
      ee.Algorithms.If(
        nEvalPolygon.gt(0),
        evaluablePolygon.aggregate_mean(
          'overlap_fraction'
        ),
        0
      )
    );


  return ee.Dictionary({

    objects_total:
      nAll,

    objects_evaluable:
      nEvalAll,

    objects_detected_any:
      allDetectedAny,

    objects_detected_any_rate:
      safeDivide(
        allDetectedAny,
        nEvalAll
      ),

    objects_detected_10pct:
      allDetected10,

    objects_detected_10pct_rate:
      safeDivide(
        allDetected10,
        nEvalAll
      ),

    objects_detected_25pct:
      allDetected25,

    objects_detected_25pct_rate:
      safeDivide(
        allDetected25,
        nEvalAll
      ),

    mean_object_coverage:
      allMeanCoverage,


    radial_objects_total:
      nRadial,

    radial_objects_evaluable:
      nEvalRadial,

    radial_objects_detected_any:
      radialDetectedAny,

    radial_objects_detected_any_rate:
      safeDivide(
        radialDetectedAny,
        nEvalRadial
      ),

    radial_objects_detected_10pct:
      radialDetected10,

    radial_objects_detected_10pct_rate:
      safeDivide(
        radialDetected10,
        nEvalRadial
      ),

    radial_objects_detected_25pct:
      radialDetected25,

    radial_objects_detected_25pct_rate:
      safeDivide(
        radialDetected25,
        nEvalRadial
      ),

    mean_radial_object_coverage:
      radialMeanCoverage,


    polygon_objects_total:
      nPolygon,

    polygon_objects_evaluable:
      nEvalPolygon,

    polygon_objects_detected_any:
      polygonDetectedAny,

    polygon_objects_detected_any_rate:
      safeDivide(
        polygonDetectedAny,
        nEvalPolygon
      ),

    polygon_objects_detected_10pct:
      polygonDetected10,

    polygon_objects_detected_10pct_rate:
      safeDivide(
        polygonDetected10,
        nEvalPolygon
      ),

    polygon_objects_detected_25pct:
      polygonDetected25,

    polygon_objects_detected_25pct_rate:
      safeDivide(
        polygonDetected25,
        nEvalPolygon
      ),

    mean_polygon_object_coverage:
      polygonMeanCoverage,

    collapsed_polygon_count:
      collapsedPolygonCount

  });

}


// =============================================================================
// 43.7 RADIAL-FOOTPRINT OVERLAP DIAGNOSTIC
// =============================================================================
//
// Chile currently contains very few radial objects, but this is retained so
// the export schema remains consistent across Tasmania, Norway and Chile.
// =============================================================================

function radialFootprintOverlapDiagnostics(
  sensitivityGT,
  radialRadiusM
) {

  radialRadiusM =
    ee.Number(
      radialRadiusM
    );


  var radials =
    sensitivityGT.filter(
      ee.Filter.eq(
        'object_type',
        'radial'
      )
    );


  var radialCount =
    radials.size();


  var withOverlapCounts =
    radials.map(
      function(f) {

        var thisID =
          ee.String(
            f.get(
              'validation_id'
            )
          );


        var thisCentre =
          f.geometry()
            .centroid(1);


        var candidatePartners =
          radials.filterBounds(
            f.geometry()
              .buffer(
                radialRadiusM.multiply(2),
                1
              )
          );


        var testedPartners =
          candidatePartners.map(
            function(g) {

              var otherID =
                ee.String(
                  g.get(
                    'validation_id'
                  )
                );


              var sameObject =
                thisID
                  .compareTo(otherID)
                  .eq(0);


              var otherCentre =
                g.geometry()
                  .centroid(1);


              var centreDistance =
                thisCentre.distance(
                  otherCentre,
                  1
                );


              var positiveAreaOverlap =
                centreDistance.lt(
                  radialRadiusM.multiply(2)
                );


              var isOverlap =
                ee.Number(
                  ee.Algorithms.If(
                    sameObject,
                    0,
                    ee.Algorithms.If(
                      positiveAreaOverlap,
                      1,
                      0
                    )
                  )
                );


              return g.set(
                'is_overlap_partner',
                isOverlap
              );

            }
          );


        var overlapPartners =
          testedPartners
            .filter(
              ee.Filter.eq(
                'is_overlap_partner',
                1
              )
            )
            .size();


        return f.set(
          'overlap_partner_count',
          overlapPartners
        );

      }
    );


  var summedPartnerCounts =
    ee.Number(
      ee.Algorithms.If(
        radialCount.gt(0),
        withOverlapCounts.aggregate_sum(
          'overlap_partner_count'
        ),
        0
      )
    );


  var overlapPairs =
    summedPartnerCounts.divide(2);


  var objectsInvolved =
    withOverlapCounts
      .filter(
        ee.Filter.gt(
          'overlap_partner_count',
          0
        )
      )
      .size();


  var maxPartners =
    ee.Number(
      ee.Algorithms.If(
        radialCount.gt(0),
        withOverlapCounts.aggregate_max(
          'overlap_partner_count'
        ),
        0
      )
    );


  return ee.Dictionary({

    overlapping_radial_pairs:
      overlapPairs,

    radial_objects_involved_in_overlap:
      objectsInvolved,

    radial_objects_overlap_rate:
      safeDivide(
        objectsInvolved,
        radialCount
      ),

    maximum_radial_overlap_partners:
      maxPartners

  });

}


// =============================================================================
// 43.8 CREATE ONE COMPLETE RESULT ROW
// =============================================================================

function makeFootprintSensitivityRow(
  scenarioName,
  radialRadiusM,
  polygonBufferM,
  methodCode,
  methodName,
  pred,
  sensitivityGT,
  sensitivityTruth,
  overlapDiagnostics
) {

  var pixelSummary =
    footprintSensitivityPixelMetrics(
      scenarioName,
      radialRadiusM,
      polygonBufferM,
      methodCode,
      methodName,
      pred,
      sensitivityTruth
    );


  var scoredObjects =
    scoreFootprintSensitivityObjects(
      sensitivityGT,
      pred
    );


  var objectSummary =
    summariseFootprintSensitivityObjects(
      scoredObjects
    );


  var combinedDictionary =
    ee.Dictionary(
      pixelSummary
    )
    .combine(
      objectSummary,
      true
    )
    .combine(
      overlapDiagnostics,
      true
    );


  return ee.Feature(
    null,
    combinedDictionary
  )
  .set({

    region:
      REGION,

    development_year:
      DEVELOPMENT_YEAR,

    evaluation_year:
      YEAR,

    sensitivity_type:
      'validation footprint boundary displacement',

    boundary_displacement_m:
      polygonBufferM,

    primary_radial_radius_m:
      ISOLATED_RADIUS_M,

    predictions_fixed:
      1,

    classifiers_retrained:
      0,

    thresholds_changed:
      0,

    scale_m:
      SCALE,

    evaluation_crs:
      AOI_CRS,

    minimum_connected_pixels:
      MIN_CONNECTED_PIXELS,

    land_water_mask:
      'ESA WorldCover 2021 class 80',

    pixel_overlap_handling:
      'validation geometries rasterised as union; overlapping truth pixels counted once',

    object_overlap_handling:
      'objects scored individually; shared pixels may contribute to multiple object summaries'

  });

}


