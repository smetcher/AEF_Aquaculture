// =============================================================================
// ALPHAEARTH FINAL CHILE HELD-OUT EVALUATION PIPELINE
// =============================================================================
//
// 2024 DEVELOPMENT -> 2025 SPATIOTEMPORALLY HELD-OUT EVALUATION
//
// MAIN COMPARISONS
//   1. Cosine 90% target retention
//   2. Cosine 95% target retention
//   3. Cosine 99% target retention
//   4. Standard Random Forest (SRF)
//   5. Class-Relationship Random Forest (CR-RF)
//
// ABLATION
//   1. Raw64
//   2. Raw64 + class similarities
//   3. Raw64 + class similarities + margins
//   4. Raw64 + class similarities + margins + all five prototypes (final)
//
// EVALUATION
//   - Fixed 30 x 30 km AOI
//   - 2025 AEF
//   - EPSG:32718
//   - ESA WorldCover 2021 class 80 permanent-water mask
//   - Minimum 5 connected positive pixels
//   - Integer pixel-level TP/TN/FP/FN
//   - Precision, recall, F1, IoU
//   - Object-level detection and overlap
//
// IMPORTANT
//   - 2024 development products are frozen.
//   - 2024 reference footprints must not intersect the evaluation AOI.
//   - Cosine thresholds are frozen from the final R development workflow.
//   - Cosine similarity is calculated as the true normalised dot product.
//   - No 2025 data are used for model tuning.
//   - Identical RF hyperparameters are used for all RF variants.
// =============================================================================


// =============================================================================
// 1. CONFIGURATION
// =============================================================================

var YEAR = 2025;
var DEVELOPMENT_YEAR = 2024;

var REGION = 'Chile';

var SCALE = 10;

var ISOLATED_RADIUS_M = 50;

var MIN_CONNECTED_PIXELS = 5;

var AOI_SIZE_M = 30000;
var AOI_HALF_SIZE_M = AOI_SIZE_M / 2;


// -----------------------------------------------------------------------------
// Evaluation projection
// -----------------------------------------------------------------------------

var AOI_CRS = 'EPSG:32718';

var AOI_PROJ =
  ee.Projection(
    AOI_CRS
  );

var EVAL_PROJ =
  AOI_PROJ.atScale(
    SCALE
  );


// -----------------------------------------------------------------------------
// Random Forest settings
// -----------------------------------------------------------------------------

var RF_NUMBER_OF_TREES = 150;
var RF_VARIABLES_PER_SPLIT = 8;
var RF_MIN_LEAF_POPULATION = 5;
var RF_BAG_FRACTION = 0.7;
var RF_SEED = 123;


// -----------------------------------------------------------------------------
// Frozen 2024 development assets
// -----------------------------------------------------------------------------

var AUGMENTED_ASSET =
  'projects/alphaearth-490619/assets/AEF_Chile_2024_Augmented';


var VECTORS_ALL_ASSET =
  'projects/alphaearth-490619/assets/AEF_Chile_2024_Vectors_AllPrototypes';


// -----------------------------------------------------------------------------
// FINAL Chile 2024 cosine thresholds
// -----------------------------------------------------------------------------

var COSINE_90 = 0.898104714624384;
var COSINE_95 = 0.874418797776275;
var COSINE_99 = 0.798988497494646;

// -----------------------------------------------------------------------------
// Export controls
// -----------------------------------------------------------------------------

var EXPORT_TABLES = true;
var EXPORT_PREDICTION_STACK = true;


// =============================================================================
// 2. STANDARDISED 30 x 30 KM AOI
// =============================================================================
//
// REQUIRED IMPORT:
//
//   AOI_Area
//
// AOI_Area = one point defining the centre of the evaluation AOI.
// =============================================================================

var aoiCentreProjected =
  AOI_Area.transform(
    AOI_PROJ,
    1
  );

var centreXY =
  ee.List(
    aoiCentreProjected.coordinates()
  );

var centreX =
  ee.Number(
    centreXY.get(0)
  );

var centreY =
  ee.Number(
    centreXY.get(1)
  );

var scanningArea =
  ee.Geometry.Rectangle(
    ee.List([
      centreX.subtract(AOI_HALF_SIZE_M),
      centreY.subtract(AOI_HALF_SIZE_M),
      centreX.add(AOI_HALF_SIZE_M),
      centreY.add(AOI_HALF_SIZE_M)
    ]),
    AOI_PROJ,
    false
  );

var centreLonLat =
  AOI_Area
    .transform(
      'EPSG:4326',
      1
    )
    .coordinates();


print('=================================================');
print('FINAL CHILE HELD-OUT EVALUATION');
print('=================================================');

print(
  'Region:',
  REGION
);

print(
  'Development year:',
  DEVELOPMENT_YEAR
);

print(
  'Evaluation year:',
  YEAR
);

print(
  'AOI centre [longitude, latitude]:',
  centreLonLat
);

print(
  'AOI dimensions:',
  AOI_SIZE_M / 1000 +
  ' km x ' +
  AOI_SIZE_M / 1000 +
  ' km'
);

print(
  'Evaluation CRS:',
  AOI_CRS
);


// =============================================================================
// 3. AEF BAND NAMES
// =============================================================================

var bandNames =
  ee.List.sequence(
    0,
    63
  )
  .map(
    function(n) {

      return ee.String('A')
        .cat(
          ee.Number(n)
            .format('%02d')
        );

    }
  );


// =============================================================================
// 4. LOAD FROZEN 2024 DEVELOPMENT ASSETS
// =============================================================================

var calibration_key =
  ee.FeatureCollection(
    AUGMENTED_ASSET
  );


var vectorsAll =
  ee.FeatureCollection(
    VECTORS_ALL_ASSET
  )
  .sort(
    'band'
  );


// =============================================================================
// 5. DEVELOPMENT-ASSET QA
// =============================================================================

// -----------------------------------------------------------------------------
// Region
// -----------------------------------------------------------------------------

var developmentRegions =
  calibration_key
    .aggregate_array(
      'region'
    )
    .distinct()
    .getInfo();


if (
  developmentRegions.length !== 1 ||
  developmentRegions[0] !== REGION
) {

  throw new Error(
    'DEVELOPMENT QA FAILED: expected region Chile, found: ' +
    developmentRegions
  );

}


// -----------------------------------------------------------------------------
// Site counts
// -----------------------------------------------------------------------------

function countDevelopmentSites(
  className
) {

  return calibration_key
    .filter(
      ee.Filter.eq(
        'class',
        className
      )
    )
    .aggregate_array(
      'site_id'
    )
    .distinct()
    .size()
    .getInfo();

}


var developmentTargetSites =
  countDevelopmentSites(
    'target'
  );

var developmentOceanSites =
  countDevelopmentSites(
    'ocean'
  );

var developmentConfoundingSites =
  countDevelopmentSites(
    'confounding_marine'
  );


if (
  developmentTargetSites !== 20 ||
  developmentOceanSites !== 20 ||
  developmentConfoundingSites !== 20
) {

  throw new Error(
    'DEVELOPMENT QA FAILED: expected 20 / 20 / 20 sites. ' +
    'Found target=' +
    developmentTargetSites +
    ', ocean=' +
    developmentOceanSites +
    ', confounding=' +
    developmentConfoundingSites
  );

}


// -----------------------------------------------------------------------------
// Sampling CRS
// -----------------------------------------------------------------------------

var developmentSamplingCRS =
  calibration_key
    .aggregate_array(
      'sampling_crs'
    )
    .distinct()
    .getInfo();


if (
  developmentSamplingCRS.length !== 1 ||
  developmentSamplingCRS[0] !== AOI_CRS
) {

  throw new Error(
    'DEVELOPMENT QA FAILED: expected sampling CRS ' +
    AOI_CRS +
    ', found: ' +
    developmentSamplingCRS
  );

}


// -----------------------------------------------------------------------------
// Sampling scale
// -----------------------------------------------------------------------------

var developmentSamplingScales =
  calibration_key
    .aggregate_array(
      'sampling_scale_m'
    )
    .distinct()
    .getInfo();


if (
  developmentSamplingScales.length !== 1 ||
  Number(developmentSamplingScales[0]) !== SCALE
) {

  throw new Error(
    'DEVELOPMENT QA FAILED: expected 10 m sampling scale, found: ' +
    developmentSamplingScales
  );

}


// -----------------------------------------------------------------------------
// Sampling radius
// -----------------------------------------------------------------------------

var developmentSamplingRadii =
  calibration_key
    .aggregate_array(
      'sampling_radius_m'
    )
    .distinct()
    .getInfo();


if (
  developmentSamplingRadii.length !== 1 ||
  Number(developmentSamplingRadii[0]) !== 50
) {

  throw new Error(
    'DEVELOPMENT QA FAILED: expected 50 m sampling radius, found: ' +
    developmentSamplingRadii
  );

}


// -----------------------------------------------------------------------------
// Reconstruct unique development footprints.
//
// The complete 50 m footprint of every 2024 development site must lie outside
// the fixed 2025 evaluation AOI.
// -----------------------------------------------------------------------------

var developmentSiteFeatures =
  calibration_key
    .distinct([
      'site_id'
    ])
    .map(
      function(f) {

        var lon =
          ee.Number(
            f.get(
              'centroid_lon'
            )
          );

        var lat =
          ee.Number(
            f.get(
              'centroid_lat'
            )
          );

        var radius =
          ee.Number(
            f.get(
              'sampling_radius_m'
            )
          );

        var centre =
          ee.Geometry.Point(
            ee.List([
              lon,
              lat
            ]),
            'EPSG:4326'
          );

        var footprint =
          centre.buffer(
            radius,
            1
          );

        return ee.Feature(
          footprint,
          {
            site_id:
              f.get(
                'site_id'
              ),

            class:
              f.get(
                'class'
              )
          }
        );

      }
    );


var overlappingDevelopmentSites =
  developmentSiteFeatures
    .filterBounds(
      scanningArea
    );


var overlappingDevelopmentIDs =
  overlappingDevelopmentSites
    .aggregate_array(
      'site_id'
    )
    .getInfo();


if (
  overlappingDevelopmentIDs.length > 0
) {

  throw new Error(
    'SPATIAL HOLDOUT QA FAILED: 2024 development footprints intersect ' +
    'the 2025 evaluation AOI: ' +
    overlappingDevelopmentIDs.join(', ')
  );

}


// -----------------------------------------------------------------------------
// Vector-table QA
// -----------------------------------------------------------------------------

var allVectorRows =
  vectorsAll
    .size()
    .getInfo();


if (
  allVectorRows !== 64
) {

  throw new Error(
    'VECTOR QA FAILED: expected exactly 64 vector rows.'
  );

}


// -----------------------------------------------------------------------------
// Detect complete prototype columns.
// -----------------------------------------------------------------------------

var allProtoNames =
  ee.List(
    vectorsAll
      .first()
      .propertyNames()
  )
  .filter(
    ee.Filter.stringStartsWith(
      'item',
      'proto_'
    )
  )
  .sort()
  .getInfo();


var expectedProtoNames = [
  'proto_1',
  'proto_2',
  'proto_3',
  'proto_4',
  'proto_5'
];


if (
  allProtoNames.length !== 5 ||
  JSON.stringify(allProtoNames) !== JSON.stringify(expectedProtoNames)
) {

  throw new Error(
    'VECTOR QA FAILED: expected prototype columns proto_1 through proto_5. Found: ' +
    allProtoNames.join(', ')
  );

}


var allProtoColumns =
  ee.List(
    allProtoNames
  );


print(
  'Development-site counts:',
  {
    target:
      developmentTargetSites,

    ocean:
      developmentOceanSites,

    confounding_marine:
      developmentConfoundingSites
  }
);

print(
  'Development sampling CRS:',
  developmentSamplingCRS
);

print(
  'Development/AOI overlap count:',
  overlappingDevelopmentIDs.length
);

print(
  'Final CR-RF prototypes:',
  allProtoNames
);


// =============================================================================
// 6. CHILE GROUND-TRUTH INPUTS
// =============================================================================
//
// REQUIRED IMPORTS:
//
//   gt_arrays
//   gt_isolated_points
//
// gt_arrays:
//   manually delineated polygonal / square-cage array footprints.
//
// gt_isolated_points:
//   isolated circular cage centres buffered to 50 m.
// =============================================================================

var ground_truth_poly =
  gt_arrays;

var ground_truth_radial =
  gt_isolated_points;


var groundTruthPolygons =
  ground_truth_poly.map(
    function(f) {

      return ee.Feature(
        f.geometry(),
        f.toDictionary()
      )
      .set({
        object_type:
          'polygon',

        radius_m:
          0
      });

    }
  );


var groundTruthRadial =
  ground_truth_radial.map(
    function(f) {

      return ee.Feature(
        f.geometry()
          .buffer(
            ISOLATED_RADIUS_M
          ),
        f.toDictionary()
      )
      .set({
        object_type:
          'radial',

        radius_m:
          ISOLATED_RADIUS_M
      });

    }
  );


var groundTruthUnindexed =
  groundTruthPolygons
    .merge(
      groundTruthRadial
    )
    .filterBounds(
      scanningArea
    );


var groundTruthCount =
  groundTruthUnindexed
    .size()
    .getInfo();


if (
  groundTruthCount < 1
) {

  throw new Error(
    'GROUND-TRUTH QA FAILED: no validation objects intersect the AOI.'
  );

}


// -----------------------------------------------------------------------------
// Add deterministic validation IDs
// -----------------------------------------------------------------------------

var gtList =
  groundTruthUnindexed.toList(
    groundTruthUnindexed.size()
  );

var gtIndex =
  ee.List.sequence(
    0,
    groundTruthUnindexed
      .size()
      .subtract(1)
  );


var groundTruth =
  ee.FeatureCollection(
    gtIndex.map(
      function(i) {

        i =
          ee.Number(i);

        var f =
          ee.Feature(
            gtList.get(i)
          );

        var objectType =
          ee.String(
            f.get(
              'object_type'
            )
          );

        var validationID =
          objectType
            .cat('_')
            .cat(
              i.add(1)
                .format('%03d')
            );

        return f.set(
          'validation_id',
          validationID
        );

      }
    )
  );


// =============================================================================
// 7. ESA WORLDCOVER PERMANENT-WATER MASK
// =============================================================================
//
// ESA WorldCover 2021:
// Class 80 = permanent water bodies.
//
// No buffering, erosion, dilation or post-hoc modification.
// =============================================================================

var worldCover =
  ee.ImageCollection(
    'ESA/WorldCover/v200'
  )
  .first()
  .select(
    'Map'
  );


var marineMask =
  worldCover
    .eq(80)
    .unmask(0)
    .toByte()
    .rename(
      'marine_mask'
    )
    .clip(
      scanningArea
    )
    .setDefaultProjection(
      EVAL_PROJ
    );


// Explicit binary evaluation domain
var evaluationDomain =
  marineMask
    .eq(1)
    .toByte()
    .rename(
      'evaluation_domain'
    )
    .clip(
      scanningArea
    )
    .setDefaultProjection(
      EVAL_PROJ
    );


// =============================================================================
// 8. LOAD 2025 ALPHAEARTH
// =============================================================================

var aefCollection =
  ee.ImageCollection(
    'GOOGLE/SATELLITE_EMBEDDING/V1/ANNUAL'
  )
  .filterDate(
    YEAR + '-01-01',
    (YEAR + 1) + '-01-01'
  )
  .filterBounds(
    scanningArea
  );


var evaluationAEFTileCount =
  aefCollection
    .size()
    .getInfo();


if (
  evaluationAEFTileCount < 1
) {

  throw new Error(
    'No AEF imagery intersects the evaluation AOI.'
  );

}


// -----------------------------------------------------------------------------
// AEF provenance
// -----------------------------------------------------------------------------

var evaluationAEFUTMZones =
  ee.List(
    aefCollection.aggregate_array(
      'UTM_ZONE'
    )
  )
  .distinct()
  .sort()
  .join('|');


var evaluationAEFDatasetVersions =
  ee.List(
    aefCollection.aggregate_array(
      'DATASET_VERSION'
    )
  )
  .distinct()
  .sort()
  .join('|');


var evaluationAEFModelVersions =
  ee.List(
    aefCollection.aggregate_array(
      'MODEL_VERSION'
    )
  )
  .distinct()
  .sort()
  .join('|');


var evaluationAEFProcessingVersions =
  ee.List(
    aefCollection.aggregate_array(
      'PROCESSING_SOFTWARE_VERSION'
    )
  )
  .distinct()
  .sort()
  .join('|');


// -----------------------------------------------------------------------------
// Spatial mosaic on the fixed Chile 10 m evaluation grid
// -----------------------------------------------------------------------------

var aef =
  aefCollection
    .mosaic()
    .select(
      bandNames
    )
    .clip(
      scanningArea
    )
    .setDefaultProjection(
      EVAL_PROJ
    )
    .updateMask(
      evaluationDomain
    );


// =============================================================================
// 9. MINIMUM CONNECTED-PIXEL FILTER
// =============================================================================

function applyMinimumConnectedPixels(
  binaryImage,
  outputName
) {

  var binary =
    binaryImage
      .clip(
        scanningArea
      )
      .unmask(0)
      .toByte()
      .setDefaultProjection(
        EVAL_PROJ
      );

  var connectedPixels =
    binary
      .selfMask()
      .connectedPixelCount(
        MIN_CONNECTED_PIXELS,
        true
      );

  return binary
    .updateMask(
      connectedPixels.gte(
        MIN_CONNECTED_PIXELS
      )
    )
    .unmask(0)
    .toByte()
    .rename(
      outputName
    )
    .clip(
      scanningArea
    )
    .setDefaultProjection(
      EVAL_PROJ
    );

}


// =============================================================================
// 10. PREPARE 2024 TRAINING DATA
// =============================================================================

var train_data =
  calibration_key.map(
    function(f) {

      var className =
        ee.String(
          f.get(
            'class'
          )
        );

      var classID =
        ee.Number(
          ee.Algorithms.If(
            className.equals(
              'target'
            ),
            1,
            ee.Algorithms.If(
              className.equals(
                'ocean'
              ),
              2,
              3
            )
          )
        );

      return f.set(
        'class_id',
        classID
      );

    }
  );


// =============================================================================
// 11. EXTRACT FROZEN CLASS VECTORS
// =============================================================================

var farmVector =
  ee.Array(
    vectorsAll.aggregate_array(
      'farm'
    )
  );


var oceanVector =
  ee.Array(
    vectorsAll.aggregate_array(
      'ocean'
    )
  );


var confVector =
  ee.Array(
    vectorsAll.aggregate_array(
      'conf'
    )
  );


// =============================================================================
// 12. TRUE COSINE-SIMILARITY FUNCTION
// =============================================================================
//
// For each 2025 AEF pixel:
//
//       cosine = dot(x, v) / (||x|| * ||v||)
//
// Explicit normalisation avoids assuming that stored AEF pixel vectors are
// numerically exact unit vectors.
// =============================================================================

function similarityBand(
  image,
  vector,
  name
) {

  var imageColumn =
    image
      .select(
        bandNames
      )
      .toArray()
      .toArray(1);


  var vectorArray =
    ee.Array(
      vector
    );


  var vectorColumn =
    vectorArray.reshape([
      64,
      1
    ]);


  var dotProduct =
    imageColumn
      .arrayTranspose()
      .matrixMultiply(
        vectorColumn
      )
      .arrayGet([
        0,
        0
      ]);


  var imageNorm =
    imageColumn
      .arrayTranspose()
      .matrixMultiply(
        imageColumn
      )
      .arrayGet([
        0,
        0
      ])
      .sqrt();


  var vectorNorm =
    ee.Number(
      vectorArray
        .pow(2)
        .reduce(
          ee.Reducer.sum(),
          [0]
        )
        .get([0])
    )
    .sqrt();


  var denominator =
    imageNorm
      .multiply(
        vectorNorm
      )
      .max(
        1e-12
      );


  return dotProduct
    .divide(
      denominator
    )
    .clamp(
      -1,
      1
    )
    .rename(
      name
    )
    .setDefaultProjection(
      EVAL_PROJ
    );

}


// =============================================================================
// 13. CLASS-SIMILARITY FEATURES
// =============================================================================

var farmSim =
  similarityBand(
    aef,
    farmVector,
    'farm_sim'
  );


var oceanSim =
  similarityBand(
    aef,
    oceanVector,
    'ocean_sim'
  );


var confSim =
  similarityBand(
    aef,
    confVector,
    'conf_sim'
  );


// =============================================================================
// 14. CLASS-SEPARATION MARGINS
// =============================================================================

var marginOcean =
  farmSim
    .subtract(
      oceanSim
    )
    .rename(
      'margin_ocean'
    );


var marginConf =
  farmSim
    .subtract(
      confSim
    )
    .rename(
      'margin_conf'
    );


var marginBestNoise =
  farmSim
    .subtract(
      oceanSim.max(
        confSim
      )
    )
    .rename(
      'margin_best_noise'
    );


// =============================================================================
// 15. PROTOTYPE-SIMILARITY BANDS
// =============================================================================

var allProtoBandsList =
  allProtoColumns.map(
    function(colName) {

      colName =
        ee.String(
          colName
        );

      var protoVector =
        ee.Array(
          vectorsAll.aggregate_array(
            colName
          )
        );

      return similarityBand(
        aef,
        protoVector,
        colName
      );

    }
  );


var allProtoImage =
  ee.ImageCollection
    .fromImages(
      allProtoBandsList
    )
    .toBands()
    .rename(
      allProtoColumns
    )
    .setDefaultProjection(
      EVAL_PROJ
    );


// =============================================================================
// 16. COMPLETE PREDICTOR IMAGE
// =============================================================================

var completePredictorImage =
  aef
    .addBands(
      farmSim
    )
    .addBands(
      oceanSim
    )
    .addBands(
      confSim
    )
    .addBands(
      marginOcean
    )
    .addBands(
      marginConf
    )
    .addBands(
      marginBestNoise
    )
    .addBands(
      allProtoImage
    );


// =============================================================================
// 17. FEATURE SETS
// =============================================================================

var classSimilarityNames =
  ee.List([
    'farm_sim',
    'ocean_sim',
    'conf_sim'
  ]);


var marginNames =
  ee.List([
    'margin_ocean',
    'margin_conf',
    'margin_best_noise'
  ]);


var raw64Bands =
  bandNames;


var raw64ClassSimilarityBands =
  bandNames
    .cat(
      classSimilarityNames
    );


var raw64ClassSimilarityMarginBands =
  bandNames
    .cat(
      classSimilarityNames
    )
    .cat(
      marginNames
    );


var finalCRRFBands =
  bandNames
    .cat(
      classSimilarityNames
    )
    .cat(
      marginNames
    )
    .cat(
      allProtoColumns
    );


var finalCRRFPredictorCount =
  finalCRRFBands
    .size()
    .getInfo();


if (
  finalCRRFPredictorCount !== 75
) {

  throw new Error(
    'FEATURE QA FAILED: final CR-RF must contain 75 predictors; found ' +
    finalCRRFPredictorCount
  );

}


print(
  'Final CR-RF predictor count:',
  finalCRRFPredictorCount
);

print(
  'Final CR-RF prototypes:',
  allProtoNames
);


// =============================================================================
// 18. RANDOM FOREST TRAINING
// =============================================================================

function trainRF(
  inputBands
) {

  return ee.Classifier
    .smileRandomForest({
      numberOfTrees:
        RF_NUMBER_OF_TREES,

      variablesPerSplit:
        RF_VARIABLES_PER_SPLIT,

      minLeafPopulation:
        RF_MIN_LEAF_POPULATION,

      bagFraction:
        RF_BAG_FRACTION,

      seed:
        RF_SEED
    })
    .train({
      features:
        train_data,

      classProperty:
        'class_id',

      inputProperties:
        inputBands
    });

}


var rfcSRF =
  trainRF(
    raw64Bands
  );


var rfcClassSimilarity =
  trainRF(
    raw64ClassSimilarityBands
  );


var rfcMargins =
  trainRF(
    raw64ClassSimilarityMarginBands
  );


var rfcCRRF =
  trainRF(
    finalCRRFBands
  );


// =============================================================================
// 19. RF CLASSIFICATION
// =============================================================================

var srfRaw =
  completePredictorImage
    .classify(
      rfcSRF
    )
    .eq(1);


var classSimilarityRaw =
  completePredictorImage
    .classify(
      rfcClassSimilarity
    )
    .eq(1);


