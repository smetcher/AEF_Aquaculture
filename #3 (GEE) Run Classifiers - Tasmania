function scoreObjects(
  methodCode,
  methodName,
  pred,
  analysisGroup
) {

  pred =
    pred
      .clip(
        scanningArea
      )
      .unmask(0)
      .toByte()
      .setDefaultProjection(
        EVAL_PROJ
      );

  return groundTruth.map(
    function(f) {

      var evalGeom =
        f.geometry()
          .intersection(
            scanningArea,
            1
          );

      var objectTruth =
        ee.Image.constant(0)
          .toByte()
          .paint({
            featureCollection:
              ee.FeatureCollection([
                ee.Feature(f)
              ]),

            color:
              1
          })
          .rename(
            'object_truth'
          )
          .clip(
            scanningArea
          )
          .setDefaultProjection(
            EVAL_PROJ
          )
          .updateMask(
            evaluationDomain
          );

      var gtPixelsImage =
        objectTruth
          .eq(1)
          .rename(
            'gt_pixels'
          )
          .toInt();

      var overlapPixelsImage =
        pred
          .eq(1)
          .and(
            objectTruth.eq(1)
          )
          .rename(
            'overlap_pixels'
          )
          .toInt();

      var objectCountImage =
        ee.Image.cat([
          gtPixelsImage,
          overlapPixelsImage
        ])
        .updateMask(
          evaluationDomain
        )
        .setDefaultProjection(
          EVAL_PROJ
        );

      var objectCounts =
        objectCountImage.reduceRegion({
          reducer:
            ee.Reducer
              .sum()
              .unweighted(),

          geometry:
            evalGeom,

          scale:
            SCALE,

          crs:
            AOI_CRS,

          maxPixels:
            1e10,

          tileScale:
            4
        });

      var gtPixels =
        safeGet(
          objectCounts,
          'gt_pixels'
        );

      var overlapPixels =
        safeGet(
          objectCounts,
          'overlap_pixels'
        );

      var gtArea =
        gtPixels.multiply(
          SCALE * SCALE
        );

      var overlapArea =
        overlapPixels.multiply(
          SCALE * SCALE
        );

      var overlapFraction =
        safeDivide(
          overlapPixels,
          gtPixels
        );

      var evaluable =
        ee.Number(
          ee.Algorithms.If(
            gtPixels.gt(0),
            1,
            0
          )
        );

      var detectedAny =
        ee.Number(
          ee.Algorithms.If(
            overlapPixels.gt(0),
            1,
            0
          )
        );

      var detected10 =
        ee.Number(
          ee.Algorithms.If(
            overlapFraction.gte(0.10),
            1,
            0
          )
        );

      var detected25 =
        ee.Number(
          ee.Algorithms.If(
            overlapFraction.gte(0.25),
            1,
            0
          )
        );

      return f.set({
        analysis_group:
          analysisGroup,

        method_code:
          methodCode,

        method:
          methodName,

        evaluable_object:
          evaluable,

        evaluable_gt_pixels:
          gtPixels,

        overlap_pixels:
          overlapPixels,

        evaluable_gt_area_m2:
          gtArea,

        overlap_area_m2:
          overlapArea,

        pred_area_inside_m2:
          overlapArea,

        overlap_fraction:
          overlapFraction,

        detected_any:
          detectedAny,

        detected_10pct:
          detected10,

        detected_25pct:
          detected25
      });

    }
  );

}


function summariseObjectSubset(
  scored,
  methodCode,
  methodName,
  analysisGroup,
  objectType,
  useAllObjects
) {

  var totalSubset =
    ee.FeatureCollection(
      ee.Algorithms.If(
        useAllObjects,
        scored,
        scored.filter(
          ee.Filter.eq(
            'object_type',
            objectType
          )
        )
      )
    );

  var evaluableSubset =
    totalSubset.filter(
      ee.Filter.eq(
        'evaluable_object',
        1
      )
    );

  var nTotal =
    totalSubset.size();

  var nEvaluable =
    evaluableSubset.size();

  var detectedAny =
    ee.Number(
      evaluableSubset.aggregate_sum(
        'detected_any'
      )
    );

  var detected10 =
    ee.Number(
      evaluableSubset.aggregate_sum(
        'detected_10pct'
      )
    );

  var detected25 =
    ee.Number(
      evaluableSubset.aggregate_sum(
        'detected_25pct'
      )
    );

  var meanOverlap =
    ee.Number(
      ee.Algorithms.If(
        nEvaluable.gt(0),
        evaluableSubset.aggregate_mean(
          'overlap_fraction'
        ),
        0
      )
    );

  var maxOverlap =
    ee.Number(
      ee.Algorithms.If(
        nEvaluable.gt(0),
        evaluableSubset.aggregate_max(
          'overlap_fraction'
        ),
        0
      )
    );

  return ee.Feature(
    null,
    {
      analysis_group:
        analysisGroup,

      method_code:
        methodCode,

      method:
        methodName,

      object_type:
        objectType,

      n_objects_total:
        nTotal,

      n_objects_evaluable:
        nEvaluable,

      n_objects_excluded:
        nTotal.subtract(
          nEvaluable
        ),

      detected_any:
        detectedAny,

      detected_any_rate:
        safeDivide(
          detectedAny,
          nEvaluable
        ),

      detected_10pct:
        detected10,

      detected_10pct_rate:
        safeDivide(
          detected10,
          nEvaluable
        ),

      detected_25pct:
        detected25,

      detected_25pct_rate:
        safeDivide(
          detected25,
          nEvaluable
        ),

      mean_overlap_fraction:
        meanOverlap,

      max_overlap_fraction:
        maxOverlap
    }
  );

}


function objectSummary(
  methodCode,
  methodName,
  pred,
  analysisGroup
) {

  var scored =
    scoreObjects(
      methodCode,
      methodName,
      pred,
      analysisGroup
    );

  var objectTypes =
    ee.List(
      groundTruth.aggregate_array(
        'object_type'
      )
    )
    .distinct()
    .sort();

  var typedSummaries =
    ee.FeatureCollection(
      objectTypes.map(
        function(objectType) {

          objectType =
            ee.String(
              objectType
            );

          return summariseObjectSubset(
            scored,
            methodCode,
            methodName,
            analysisGroup,
            objectType,
            false
          );

        }
      )
    );

  var allSummary =
    ee.FeatureCollection([
      summariseObjectSubset(
        scored,
        methodCode,
        methodName,
        analysisGroup,
        'all',
        true
      )
    ]);

  return typedSummaries.merge(
    allSummary
  );

}


