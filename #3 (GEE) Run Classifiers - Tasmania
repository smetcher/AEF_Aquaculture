function similarityBand(
  image,
  vector,
  name
) {

  var imageColumn =
    image
      .select(
        bandNames
      )
      .toArray()
      .toArray(1);

  var vectorArray =
    ee.Array(
      vector
    );

  var vectorColumn =
    vectorArray.reshape([
      64,
      1
    ]);

  var dotProduct =
    imageColumn
      .arrayTranspose()
      .matrixMultiply(
        vectorColumn
      )
      .arrayGet([
        0,
        0
      ]);

  var imageNorm =
    imageColumn
      .arrayTranspose()
      .matrixMultiply(
        imageColumn
      )
      .arrayGet([
        0,
        0
      ])
      .sqrt();

  var vectorNorm =
    ee.Number(
      vectorArray
        .pow(2)
        .reduce(
          ee.Reducer.sum(),
          [0]
        )
        .get([0])
    )
    .sqrt();

  var denominator =
    imageNorm
      .multiply(
        vectorNorm
      )
      .max(
        1e-12
      );

  return dotProduct
    .divide(
      denominator
    )
    .clamp(
      -1,
      1
    )
    .rename(
      name
    )
    .setDefaultProjection(
      EVAL_PROJ
    );

}


