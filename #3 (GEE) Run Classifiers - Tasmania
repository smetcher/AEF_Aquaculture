function safeGet(
  dict,
  key
) {

  dict =
    ee.Dictionary(
      dict
    );

  return ee.Number(
    ee.Algorithms.If(
      dict.contains(key),
      dict.get(key),
      0
    )
  );

}


function safeDivide(
  num,
  den
) {

  num =
    ee.Number(num);

  den =
    ee.Number(den);

  return ee.Number(
    ee.Algorithms.If(
      den.neq(0),
      num.divide(den),
      0
    )
  );

}


function pixelMetrics(
  methodCode,
  methodName,
  pred,
  analysisGroup
) {

  pred =
    pred
      .rename(
        'prediction'
      )
      .clip(
        scanningArea
      )
      .unmask(0)
      .toByte()
      .setDefaultProjection(
        EVAL_PROJ
      );

  var truthBinary =
    truth
      .unmask(0)
      .toByte()
      .setDefaultProjection(
        EVAL_PROJ
      );

  var tp =
    pred
      .eq(1)
      .and(
        truthBinary.eq(1)
      )
      .rename('TP')
      .toInt();

  var fp =
    pred
      .eq(1)
      .and(
        truthBinary.eq(0)
      )
      .rename('FP')
      .toInt();

  var fn =
    pred
      .eq(0)
      .and(
        truthBinary.eq(1)
      )
      .rename('FN')
      .toInt();

  var tn =
    pred
      .eq(0)
      .and(
        truthBinary.eq(0)
      )
      .rename('TN')
      .toInt();

  var countImage =
    ee.Image.cat([
      tp,
      fp,
      fn,
      tn
    ])
    .updateMask(
      evaluationDomain
    )
    .setDefaultProjection(
      EVAL_PROJ
    );

  var counts =
    countImage.reduceRegion({
      reducer:
        ee.Reducer
          .sum()
          .unweighted(),

      geometry:
        scanningArea,

      scale:
        SCALE,

      crs:
        AOI_CRS,

      maxPixels:
        1e13,

      tileScale:
        4
    });

  var TP =
    safeGet(
      counts,
      'TP'
    );

  var FP =
    safeGet(
      counts,
      'FP'
    );

  var FN =
    safeGet(
      counts,
      'FN'
    );

  var TN =
    safeGet(
      counts,
      'TN'
    );

  var totalPixels =
    TP
      .add(TN)
      .add(FP)
      .add(FN);

  var precision =
    safeDivide(
      TP,
      TP.add(FP)
    );

  var recall =
    safeDivide(
      TP,
      TP.add(FN)
    );

  var f1 =
    safeDivide(
      TP.multiply(2),
      TP.multiply(2)
        .add(FP)
        .add(FN)
    );

  var iou =
    safeDivide(
      TP,
      TP
        .add(FP)
        .add(FN)
    );

  return ee.Feature(
    null,
    {
      analysis_group:
        analysisGroup,

      method_code:
        methodCode,

      method:
        methodName,

      evaluated_pixels:
        totalPixels,

      TP_pixels:
        TP,

      TN_pixels:
        TN,

      FP_pixels:
        FP,

      FN_pixels:
        FN,

      precision:
        precision,

      recall:
        recall,

      F1:
        f1,

      IoU:
        iou
    }
  );

}


