function footprintSensitivityPixelMetrics(
  scenarioName,
  radialRadiusM,
  polygonBufferM,
  methodCode,
  methodName,
  pred,
  sensitivityTruth
) {

  pred =
    pred
      .rename(
        'prediction'
      )
      .clip(
        scanningArea
      )
      .unmask(
        0
      )
      .toByte()
      .setDefaultProjection(
        EVAL_PROJ
      );

  var truthBinary =
    sensitivityTruth
      .unmask(
        0
      )
      .toByte()
      .setDefaultProjection(
        EVAL_PROJ
      );

  var tp =
    pred
      .eq(
        1
      )
      .and(
        truthBinary.eq(
          1
        )
      )
      .rename(
        'TP'
      )
      .toInt();

  var fp =
    pred
      .eq(
        1
      )
      .and(
        truthBinary.eq(
          0
        )
      )
      .rename(
        'FP'
      )
      .toInt();

  var fn =
    pred
      .eq(
        0
      )
      .and(
        truthBinary.eq(
          1
        )
      )
      .rename(
        'FN'
      )
      .toInt();

  var tn =
    pred
      .eq(
        0
      )
      .and(
        truthBinary.eq(
          0
        )
      )
      .rename(
        'TN'
      )
      .toInt();

  var countImage =
    ee.Image.cat([
      tp,
      fp,
      fn,
      tn
    ])
    .updateMask(
      evaluationDomain
    )
    .setDefaultProjection(
      EVAL_PROJ
    );

  var counts =
    countImage.reduceRegion({
      reducer:
        ee.Reducer
          .sum()
          .unweighted(),

      geometry:
        scanningArea,

      scale:
        SCALE,

      crs:
        AOI_CRS,

      maxPixels:
        1e13,

      tileScale:
        4
    });


  var TP =
    safeGet(
      counts,
      'TP'
    );

  var FP =
    safeGet(
      counts,
      'FP'
    );

  var FN =
    safeGet(
      counts,
      'FN'
    );

  var TN =
    safeGet(
      counts,
      'TN'
    );


  var precision =
    safeDivide(
      TP,
      TP.add(
        FP
      )
    );

  var recall =
    safeDivide(
      TP,
      TP.add(
        FN
      )
    );

  var f1 =
    safeDivide(
      TP.multiply(
        2
      ),
      TP.multiply(
        2
      )
      .add(
        FP
      )
      .add(
        FN
      )
    );

  var iou =
    safeDivide(
      TP,
      TP
        .add(
          FP
        )
        .add(
          FN
        )
    );


  return ee.Dictionary({
    sensitivity_scenario:
      scenarioName,

    radial_radius_m:
      radialRadiusM,

    polygon_buffer_m:
      polygonBufferM,

    method_code:
      methodCode,

    method:
      methodName,

    TP_pixels:
      TP,

    TN_pixels:
      TN,

    FP_pixels:
      FP,

    FN_pixels:
      FN,

    precision:
      precision,

    recall:
      recall,

    F1:
      f1,

    IoU:
      iou
  });

}


function scoreFootprintSensitivityObjects(
  sensitivityGT,
  pred
) {

  pred =
    pred
      .clip(
        scanningArea
      )
      .unmask(
        0
      )
      .toByte()
      .setDefaultProjection(
        EVAL_PROJ
      );


  return sensitivityGT.map(
    function(f) {

      var evalGeom =
        f.geometry()
          .intersection(
            scanningArea,
            1
          );

      var objectTruth =
        ee.Image.constant(
          0
        )
        .toByte()
        .paint({
          featureCollection:
            ee.FeatureCollection([
              ee.Feature(
                f
              )
            ]),

          color:
            1
        })
        .rename(
          'object_truth'
        )
        .clip(
          scanningArea
        )
        .setDefaultProjection(
          EVAL_PROJ
        )
        .updateMask(
          evaluationDomain
        );

      var gtPixelsImage =
        objectTruth
          .eq(
            1
          )
          .rename(
            'gt_pixels'
          )
          .toInt();

      var overlapPixelsImage =
        pred
          .eq(
            1
          )
          .and(
            objectTruth.eq(
              1
            )
          )
          .rename(
            'overlap_pixels'
          )
          .toInt();

      var countImage =
        ee.Image.cat([
          gtPixelsImage,
          overlapPixelsImage
        ])
        .updateMask(
          evaluationDomain
        )
        .setDefaultProjection(
          EVAL_PROJ
        );

      var counts =
        countImage.reduceRegion({
          reducer:
            ee.Reducer
              .sum()
              .unweighted(),

          geometry:
            evalGeom,

          scale:
            SCALE,

          crs:
            AOI_CRS,

          maxPixels:
            1e10,

          tileScale:
            4
        });

      var gtPixels =
        safeGet(
          counts,
          'gt_pixels'
        );

      var overlapPixels =
        safeGet(
          counts,
          'overlap_pixels'
        );

      var overlapFraction =
        safeDivide(
          overlapPixels,
          gtPixels
        );

      var evaluable =
        ee.Number(
          ee.Algorithms.If(
            gtPixels.gt(
              0
            ),
            1,
            0
          )
        );

      var detectedAny =
        ee.Number(
          ee.Algorithms.If(
            overlapPixels.gt(
              0
            ),
            1,
            0
          )
        );

      var detected10 =
        ee.Number(
          ee.Algorithms.If(
            overlapFraction.gte(
              0.10
            ),
            1,
            0
          )
        );

      var detected25 =
        ee.Number(
          ee.Algorithms.If(
            overlapFraction.gte(
              0.25
            ),
            1,
            0
          )
        );

      return f.set({
        evaluable_object:
          evaluable,

        evaluable_gt_pixels:
          gtPixels,

        overlap_pixels:
          overlapPixels,

        overlap_fraction:
          overlapFraction,

        detected_any:
          detectedAny,

        detected_10pct:
          detected10,

        detected_25pct:
          detected25
      });

    }
  );

}


function summariseFootprintSensitivityObjects(
  scoredObjects
) {

  var evaluableAll =
    scoredObjects.filter(
      ee.Filter.eq(
        'evaluable_object',
        1
      )
    );

  var radialAll =
    scoredObjects.filter(
      ee.Filter.eq(
        'object_type',
        'radial'
      )
    );

  var polygonAll =
    scoredObjects.filter(
      ee.Filter.eq(
        'object_type',
        'polygon'
      )
    );

  var evaluableRadial =
    radialAll.filter(
      ee.Filter.eq(
        'evaluable_object',
        1
      )
    );

  var evaluablePolygon =
    polygonAll.filter(
      ee.Filter.eq(
        'evaluable_object',
        1
      )
    );

  var nAll =
    scoredObjects.size();

  var nEvalAll =
    evaluableAll.size();

  var nRadial =
    radialAll.size();

  var nEvalRadial =
    evaluableRadial.size();

  var nPolygon =
    polygonAll.size();

  var nEvalPolygon =
    evaluablePolygon.size();

  var collapsedPolygonCount =
    polygonAll
      .filter(
        ee.Filter.eq(
          'collapsed_polygon',
          1
        )
      )
      .size();


  var allDetectedAny =
    ee.Number(
      evaluableAll.aggregate_sum(
        'detected_any'
      )
    );

  var allDetected10 =
    ee.Number(
      evaluableAll.aggregate_sum(
        'detected_10pct'
      )
    );

  var allDetected25 =
    ee.Number(
      evaluableAll.aggregate_sum(
        'detected_25pct'
      )
    );

  var allMeanCoverage =
    ee.Number(
      ee.Algorithms.If(
        nEvalAll.gt(
          0
        ),
        evaluableAll.aggregate_mean(
          'overlap_fraction'
        ),
        0
      )
    );


  var radialDetectedAny =
    ee.Number(
      ee.Algorithms.If(
        nEvalRadial.gt(
          0
        ),
        evaluableRadial.aggregate_sum(
          'detected_any'
        ),
        0
      )
    );

  var radialDetected10 =
    ee.Number(
      ee.Algorithms.If(
        nEvalRadial.gt(
          0
        ),
        evaluableRadial.aggregate_sum(
          'detected_10pct'
        ),
        0
      )
    );

  var radialDetected25 =
    ee.Number(
      ee.Algorithms.If(
        nEvalRadial.gt(
          0
        ),
        evaluableRadial.aggregate_sum(
          'detected_25pct'
        ),
        0
      )
    );

  var radialMeanCoverage =
    ee.Number(
      ee.Algorithms.If(
        nEvalRadial.gt(
          0
        ),
        evaluableRadial.aggregate_mean(
          'overlap_fraction'
        ),
        0
      )
    );


  var polygonDetectedAny =
    ee.Number(
      ee.Algorithms.If(
        nEvalPolygon.gt(
          0
        ),
        evaluablePolygon.aggregate_sum(
          'detected_any'
        ),
        0
      )
    );

  var polygonDetected10 =
    ee.Number(
      ee.Algorithms.If(
        nEvalPolygon.gt(
          0
        ),
        evaluablePolygon.aggregate_sum(
          'detected_10pct'
        ),
        0
      )
    );

  var polygonDetected25 =
    ee.Number(
      ee.Algorithms.If(
        nEvalPolygon.gt(
          0
        ),
        evaluablePolygon.aggregate_sum(
          'detected_25pct'
        ),
        0
      )
    );

  var polygonMeanCoverage =
    ee.Number(
      ee.Algorithms.If(
        nEvalPolygon.gt(
          0
        ),
        evaluablePolygon.aggregate_mean(
          'overlap_fraction'
        ),
        0
      )
    );


  return ee.Dictionary({
    objects_total:
      nAll,

    objects_evaluable:
      nEvalAll,

    objects_detected_any:
      allDetectedAny,

    objects_detected_any_rate:
      safeDivide(
        allDetectedAny,
        nEvalAll
      ),

    objects_detected_10pct:
      allDetected10,

    objects_detected_10pct_rate:
      safeDivide(
        allDetected10,
        nEvalAll
      ),

    objects_detected_25pct:
      allDetected25,

    objects_detected_25pct_rate:
      safeDivide(
        allDetected25,
        nEvalAll
      ),

    mean_object_coverage:
      allMeanCoverage,

    radial_objects_total:
      nRadial,

    radial_objects_evaluable:
      nEvalRadial,

    radial_objects_detected_any:
      radialDetectedAny,

    radial_objects_detected_any_rate:
      safeDivide(
        radialDetectedAny,
        nEvalRadial
      ),

    radial_objects_detected_10pct:
      radialDetected10,

    radial_objects_detected_10pct_rate:
      safeDivide(
        radialDetected10,
