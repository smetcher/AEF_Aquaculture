function applyMinimumConnectedPixels(
  binaryImage,
  outputName
) {

  var binary =
    binaryImage
      .clip(
        scanningArea
      )
      .unmask(0)
      .toByte()
      .setDefaultProjection(
        EVAL_PROJ
      );

  var connectedPixels =
    binary
      .selfMask()
      .connectedPixelCount(
        MIN_CONNECTED_PIXELS,
        true
      );

  return binary
    .updateMask(
      connectedPixels.gte(
        MIN_CONNECTED_PIXELS
      )
    )
    .unmask(0)
    .toByte()
    .rename(
      outputName
    )
    .clip(
      scanningArea
    )
    .setDefaultProjection(
      EVAL_PROJ
    );

}


