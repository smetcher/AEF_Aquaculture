function importanceCollection(
  methodCode,
  methodName,
  classifier
) {

  var importance =
    ee.Dictionary(
      classifier
        .explain()
        .get(
          'importance'
        )
    );

  return ee.FeatureCollection(
    importance
      .keys()
      .sort()
      .map(
        function(featureName) {

          featureName =
            ee.String(
              featureName
            );

          return ee.Feature(
            null,
            {
              method_code:
                methodCode,

              method:
                methodName,

              feature:
                featureName,

              importance:
                importance.get(
                  featureName
                )
            }
          );

        }
      )
  );

}


