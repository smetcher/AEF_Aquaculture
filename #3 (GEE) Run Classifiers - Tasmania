  });

}


function radialFootprintOverlapDiagnostics(
  sensitivityGT,
  radialRadiusM
) {

  radialRadiusM =
    ee.Number(
      radialRadiusM
    );

  var radials =
    sensitivityGT.filter(
      ee.Filter.eq(
        'object_type',
        'radial'
      )
    );

  var radialCount =
    radials.size();

  var withOverlapCounts =
    radials.map(
      function(f) {

        var thisID =
          ee.String(
            f.get(
              'validation_id'
            )
          );

        var thisCentre =
          f.geometry()
            .centroid(
              1
            );

        var candidatePartners =
          radials.filterBounds(
            f.geometry()
              .buffer(
                radialRadiusM.multiply(
                  2
                ),
                1
              )
          );

        var testedPartners =
          candidatePartners.map(
            function(g) {

              var otherID =
                ee.String(
                  g.get(
                    'validation_id'
                  )
                );

              var sameObject =
                thisID.compareTo(
                  otherID
                )
                .eq(
                  0
                );

              var otherCentre =
                g.geometry()
                  .centroid(
                    1
                  );

              var centreDistance =
                thisCentre.distance(
                  otherCentre,
                  1
                );

              var positiveAreaOverlap =
                centreDistance.lt(
                  radialRadiusM.multiply(
                    2
                  )
                );

              var isOverlap =
                ee.Number(
                  ee.Algorithms.If(
                    sameObject,
                    0,
                    ee.Algorithms.If(
                      positiveAreaOverlap,
                      1,
                      0
                    )
                  )
                );

              return g.set(
                'is_overlap_partner',
                isOverlap
              );

            }
          );

        var overlapPartners =
          testedPartners
            .filter(
              ee.Filter.eq(
                'is_overlap_partner',
                1
              )
            )
            .size();

        return f.set(
          'overlap_partner_count',
          overlapPartners
        );

      }
    );

  var summedPartnerCounts =
    ee.Number(
      ee.Algorithms.If(
        radialCount.gt(
          0
        ),
        withOverlapCounts.aggregate_sum(
          'overlap_partner_count'
        ),
        0
      )
    );

  var overlapPairs =
    summedPartnerCounts.divide(
      2
    );

  var objectsInvolved =
    withOverlapCounts
      .filter(
        ee.Filter.gt(
          'overlap_partner_count',
          0
        )
      )
      .size();

  var maxPartners =
    ee.Number(
      ee.Algorithms.If(
        radialCount.gt(
          0
        ),
        withOverlapCounts.aggregate_max(
          'overlap_partner_count'
        ),
        0
      )
    );

  return ee.Dictionary({
    overlapping_radial_pairs:
      overlapPairs,

    radial_objects_involved_in_overlap:
      objectsInvolved,

    radial_objects_overlap_rate:
      safeDivide(
        objectsInvolved,
        radialCount
      ),

    maximum_radial_overlap_partners:
      maxPartners
  });

}


function makeFootprintSensitivityRow(
  scenarioName,
  radialRadiusM,
  polygonBufferM,
  methodCode,
  methodName,
  pred,
  sensitivityGT,
  sensitivityTruth,
  overlapDiagnostics
) {

  var pixelSummary =
    footprintSensitivityPixelMetrics(
      scenarioName,
      radialRadiusM,
      polygonBufferM,
      methodCode,
      methodName,
      pred,
      sensitivityTruth
    );

  var scoredObjects =
    scoreFootprintSensitivityObjects(
      sensitivityGT,
      pred
    );

  var objectSummary =
    summariseFootprintSensitivityObjects(
      scoredObjects
    );

  var combinedDictionary =
    ee.Dictionary(
      pixelSummary
    )
    .combine(
      objectSummary,
      true
    )
    .combine(
      overlapDiagnostics,
      true
    );

  return ee.Feature(
    null,
    combinedDictionary
  )
  .set({
    region:
      REGION,

    development_year:
      DEVELOPMENT_YEAR,

    evaluation_year:
      YEAR,

    sensitivity_type:
      'validation footprint boundary displacement',

    boundary_displacement_m:
      polygonBufferM,

    primary_radial_radius_m:
      ISOLATED_RADIUS_M,

    predictions_fixed:
      1,

    classifiers_retrained:
      0,

    thresholds_changed:
      0,

    scale_m:
      SCALE,

    evaluation_crs:
      AOI_CRS,

    minimum_connected_pixels:
      MIN_CONNECTED_PIXELS,

    land_water_mask:
      'ESA WorldCover 2021 class 80',

    pixel_overlap_handling:
      'validation geometries rasterised as union; overlapping truth pixels counted once',

    object_overlap_handling:
      'objects scored individually; shared pixels may contribute to multiple object summaries'
  });

}


