function buildFootprintSensitivityGroundTruth(
  scenarioName,
  radialRadiusM,
  polygonBufferM
) {

  radialRadiusM =
    ee.Number(
      radialRadiusM
    );

  polygonBufferM =
    ee.Number(
      polygonBufferM
    );


  var polygons =
    ground_truth_poly.map(
      function(f) {

        var originalGeom =
          f.geometry();

        var sensitivityGeom =
          ee.Geometry(
            ee.Algorithms.If(
              polygonBufferM.eq(0),
              originalGeom,
              originalGeom.buffer(
                polygonBufferM,
                1
              )
            )
          );

        var sensitivityArea =
          sensitivityGeom.area(
            1
          );

        return ee.Feature(
          sensitivityGeom,
          f.toDictionary()
        )
        .set({
          object_type:
            'polygon',

          radius_m:
            0,

          sensitivity_scenario:
            scenarioName,

          polygon_buffer_m:
            polygonBufferM,

          radial_radius_m:
            0,

          sensitivity_area_m2:
            sensitivityArea,

          collapsed_polygon:
            ee.Number(
              ee.Algorithms.If(
                sensitivityArea.gt(
                  0
                ),
                0,
                1
              )
            )
        });

      }
    );


  var radials =
    ground_truth_radial.map(
      function(f) {

        var sensitivityGeom =
          f.geometry()
            .buffer(
              radialRadiusM,
              1
            );

        return ee.Feature(
          sensitivityGeom,
          f.toDictionary()
        )
        .set({
          object_type:
            'radial',

          radius_m:
            radialRadiusM,

          sensitivity_scenario:
            scenarioName,

          polygon_buffer_m:
            0,

          radial_radius_m:
            radialRadiusM,

          sensitivity_area_m2:
            sensitivityGeom.area(
              1
            ),

          collapsed_polygon:
            0
        });

      }
    );


  var combined =
    polygons
      .merge(
        radials
      )
      .filterBounds(
        scanningArea
      );


  var combinedList =
    combined.toList(
      combined.size()
    );

  var combinedIndex =
    ee.List.sequence(
      0,
      combined
        .size()
        .subtract(
          1
        )
    );


  return ee.FeatureCollection(
    combinedIndex.map(
      function(i) {

        i =
          ee.Number(
            i
          );

        var f =
          ee.Feature(
            combinedList.get(
              i
            )
          );

        var objectType =
          ee.String(
            f.get(
              'object_type'
            )
          );

        var validationID =
          objectType
            .cat(
              '_'
            )
            .cat(
              i
                .add(
                  1
                )
                .format(
                  '%03d'
                )
            );

        return f.set(
          'validation_id',
          validationID
        );

      }
    )
  );

}


